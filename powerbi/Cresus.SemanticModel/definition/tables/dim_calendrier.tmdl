	partition dim_calendrier = m
		mode: import
		source =
				let
				    Source = if ModeSource = "CSV" then
				        Table.PromoteHeaders(Csv.Document(File.Contents(DossierExports & "\dim_calendrier.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])
				    else if ModeSource = "MySQL" then
				        MySQL.Database(ServeurMySQL, BaseMySQL, [ReturnSingleDatabase=true, CreateNavigationProperties=false, Query="SELECT * FROM `dim_calendrier`"])
				    else error "ModeSource doit valoir MySQL ou CSV",
				    Types = Table.TransformColumnTypes(Source, {{"date_id", Int64.Type}, {"date", type date}, {"jour", Int64.Type}, {"mois", Int64.Type}, {"annee", Int64.Type}, {"jour_semaine", Int64.Type}, {"ouvre_fra", Int64.Type}, {"ouvre_can", Int64.Type}, {"ouvre_civ", Int64.Type}}, "en-US")
				in
				    Types


	partition v_position_projetee = m
		mode: import
		source =
				let
				    Source = if ModeSource = "CSV" then
				        Table.PromoteHeaders(Csv.Document(File.Contents(DossierExports & "\v_position_projetee.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])
				    else if ModeSource = "MySQL" then
				        MySQL.Database(ServeurMySQL, BaseMySQL, [ReturnSingleDatabase=true, CreateNavigationProperties=false, Query="SELECT * FROM `v_position_projetee`"])
				    else error "ModeSource doit valoir MySQL ou CSV",
				    Types = Table.TransformColumnTypes(Source, {{"id_filiale", Int64.Type}, {"nom_filiale", type text}, {"code_devise", type text}, {"date", type date}, {"modele", type text}, {"modele_retenu", Int64.Type}, {"flux_net", Currency.Type}, {"borne_basse", Currency.Type}, {"borne_haute", Currency.Type}, {"position_projetee", Currency.Type}, {"position_projetee_usd", Currency.Type}, {"seuil_alerte", Currency.Type}, {"statut_liquidite", type text}}, "en-US")
				in
				    Types


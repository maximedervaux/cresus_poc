	partition v_position_realisee = m
		mode: import
		source =
				let
				    Source = if ModeSource = "CSV" then
				        Table.PromoteHeaders(Csv.Document(File.Contents(DossierExports & "\v_position_realisee.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])
				    else if ModeSource = "MySQL" then
				        MySQL.Database(ServeurMySQL, BaseMySQL, [ReturnSingleDatabase=true, CreateNavigationProperties=false, Query="SELECT * FROM `v_position_realisee`"])
				    else error "ModeSource doit valoir MySQL ou CSV",
				    Types = Table.TransformColumnTypes(Source, {{"id_filiale", Int64.Type}, {"nom_filiale", type text}, {"code_devise", type text}, {"date", type date}, {"flux_net", Currency.Type}, {"position", Currency.Type}, {"position_usd", Currency.Type}, {"seuil_alerte", Currency.Type}, {"seuil_alerte_usd", Currency.Type}, {"statut_liquidite", type text}}, "en-US")
				in
				    Types


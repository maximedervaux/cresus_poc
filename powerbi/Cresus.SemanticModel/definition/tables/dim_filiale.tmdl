	partition dim_filiale = m
		mode: import
		source =
				let
				    Source = if ModeSource = "CSV" then
				        Table.PromoteHeaders(Csv.Document(File.Contents(DossierExports & "\dim_filiale.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])
				    else if ModeSource = "MySQL" then
				        MySQL.Database(ServeurMySQL, BaseMySQL, [ReturnSingleDatabase=true, CreateNavigationProperties=false, Query="SELECT * FROM `dim_filiale`"])
				    else error "ModeSource doit valoir MySQL ou CSV",
				    Types = Table.TransformColumnTypes(Source, {{"id_filiale", Int64.Type}, {"nom_filiale", type text}, {"pays", type text}, {"zone_geo", type text}, {"devise_principale", type text}, {"seuil_alerte", Currency.Type}}, "en-US")
				in
				    Types


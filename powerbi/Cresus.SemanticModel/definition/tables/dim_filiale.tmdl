		sourceColumn: id_filiale

	column nom_filiale
		dataType: string
		lineageTag: f3934d69-dde1-44dc-b47e-cccc392b890a
		summarizeBy: none
		sourceColumn: nom_filiale

	column pays
		dataType: string
		lineageTag: ce64130d-58d5-46eb-9de5-1cec7206425a

	partition perf_modele = m
		mode: import
		source =
				let
				    Source = if ModeSource = "CSV" then
				        Table.PromoteHeaders(Csv.Document(File.Contents(DossierExports & "\perf_modele.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])
				    else if ModeSource = "MySQL" then
				        MySQL.Database(ServeurMySQL, BaseMySQL, [ReturnSingleDatabase=true, CreateNavigationProperties=false, Query="SELECT * FROM `perf_modele`"])
				    else error "ModeSource doit valoir MySQL ou CSV",
				    Types = Table.TransformColumnTypes(Source, {{"id_filiale", Int64.Type}, {"modele", type text}, {"date_generation", type date}, {"nb_jours", Int64.Type}, {"mae", Currency.Type}, {"wape_pct", type number}, {"ecart_position_j30", Currency.Type}, {"retenu", Int64.Type}}, "en-US")
				in
				    Types


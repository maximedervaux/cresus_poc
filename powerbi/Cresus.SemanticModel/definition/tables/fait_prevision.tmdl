	partition fait_prevision = m
		mode: import
		source =
				let
				    Source = if ModeSource = "CSV" then
				        Table.PromoteHeaders(Csv.Document(File.Contents(DossierExports & "\fait_prevision.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])
				    else if ModeSource = "MySQL" then
				        MySQL.Database(ServeurMySQL, BaseMySQL, [ReturnSingleDatabase=true, CreateNavigationProperties=false, Query="SELECT * FROM `fait_prevision`"])
				    else error "ModeSource doit valoir MySQL ou CSV",
				    Types = Table.TransformColumnTypes(Source, {{"id_prevision", Int64.Type}, {"type_run", type text}, {"date_generation", type date}, {"date_cible", type date}, {"id_filiale", Int64.Type}, {"code_devise", type text}, {"modele", type text}, {"montant_prevu", Currency.Type}, {"borne_basse", Currency.Type}, {"borne_haute", Currency.Type}}, "en-US")
				in
				    Types


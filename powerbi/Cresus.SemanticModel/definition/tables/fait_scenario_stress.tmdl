	partition fait_scenario_stress = m
		mode: import
		source =
				let
				    Source = if ModeSource = "CSV" then
				        Table.PromoteHeaders(Csv.Document(File.Contents(DossierExports & "\fait_scenario_stress.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])
				    else if ModeSource = "MySQL" then
				        MySQL.Database(ServeurMySQL, BaseMySQL, [ReturnSingleDatabase=true, CreateNavigationProperties=false, Query="SELECT * FROM `fait_scenario_stress`"])
				    else error "ModeSource doit valoir MySQL ou CSV",
				    Types = Table.TransformColumnTypes(Source, {{"id_scenario", Int64.Type}, {"libelle_scenario", type text}, {"date_cible", type date}, {"id_filiale", Int64.Type}, {"code_devise", type text}, {"type_choc", type text}, {"valeur_choc", type number}, {"montant_base", Currency.Type}, {"montant_stresse", Currency.Type}, {"position_base_usd", Currency.Type}, {"position_stressee_usd", Currency.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table

